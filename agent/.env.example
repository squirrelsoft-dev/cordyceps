# Cordyceps agent — copy to `.env` and adjust, or export these.

# The model backing the coding agent. Run gemma4:e4b OR BETTER — small models
# (e.g. llama3.2 3B) narrate tool use instead of emitting tool calls, so they
# never act. Default: gemma4:e4b. Override per-run with `--model <id>`.
SPORE_OLLAMA_MODEL=gemma4:e4b

# Override the Ollama endpoint (default: http://localhost:11434).
SPORE_OLLAMA_BASE_URL=http://localhost:11434

# Reasoning effort: off | low | medium | high | max. gemma4 over-reasons at full
# depth, so the default is the bounded `low` (→ Ollama `think: "low"`, gated on
# the model's "thinking" capability; the live trace prints as `reason ·` lines).
# Raise for harder tasks, or set `off` to reproduce a pre-reasoning ledger run.
# SPORE_REASONING_EFFORT=low

# The workspace root the agent reads/writes (read-write sandbox). Defaults to the
# directory you launch from; override here or with `--workspace <path>`. For the
# hillclimb strategy this MUST be the cordyceps repo root, so the held-out
# examiner (csv-examiner) is reachable from it.
# SPORE_WORKSPACE=/path/to/cordyceps
